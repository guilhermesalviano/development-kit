// Barra superior estilo Omarchy. Ícones da fonte FontAwesome (fonts-font-awesome).
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "bluetooth", "network", "pulseaudio", "cpu", "custom/power"],

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": { "*": 5 }
  },

  "clock": {
    "format": "{:%A %H:%M}",
    "format-alt": "{:%d de %B, semana %V}",
    "tooltip": false
  },

  "tray": { "spacing": 10 },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname} {ipaddr}",
    "tooltip-format-disconnected": "Sem conexão",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", ""] },
    "tooltip-format": "{desc}: {volume}%",
    "on-click": "pavucontrol"
  },

  "cpu": {
    "interval": 5,
    "format": "",
    "tooltip-format": "CPU {usage}%",
    "on-click": "alacritty -e btop"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/power-menu.sh"
  }
}
